# Database used by Docker Compose and the Flask API
MYSQL_DATABASE=stayease
MYSQL_USER=stayease
MYSQL_PASSWORD=change-me-for-local-development
MYSQL_ROOT_PASSWORD=change-root-password
DATABASE_URL=mysql+pymysql://stayease:change-me-for-local-development@db:3306/stayease

# Application security
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FLASK_ENV=development

# Browser application
VITE_API_URL=http://localhost:5000/api
